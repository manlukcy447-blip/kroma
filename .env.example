NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/kroma

# Admin bootstrap
ADMIN_EMAIL=admin@example.com
# Generate with: npm run db:generate-admin -- YourStrongPassword
ADMIN_PASSWORD_HASH=scrypt:CHANGE_ME:CHANGE_ME
ADMIN_JWT_SECRET=replace-with-a-long-random-secret
USER_JWT_SECRET=replace-with-a-long-random-secret

# Single-service deployment leaves this blank. Set it only if frontend/API are on different origins.
VITE_API_URL=
FRONTEND_ORIGIN=https://your-domain.example

# Password reset email. Resend API is preferred for free/serverless-friendly deployments.
RESEND_API_KEY=
MAIL_FROM=Kroma <noreply@yourdomain.com>
# SMTP fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Blockchain testnet / provider configuration
RPC_ETHEREUM_SEPOLIA_URL=
RPC_ETHEREUM_MAINNET_URL=
CONFIRMATIONS_ETHEREUM_SEPOLIA=12
CONFIRMATIONS_ETHEREUM_MAINNET=12

# Withdrawal risk controls
WITHDRAWAL_HIGH_VALUE_THRESHOLD=10000
WITHDRAWAL_VELOCITY_LIMIT=5
REQUIRE_ADMIN_2FA=false
